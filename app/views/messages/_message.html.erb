
<div id="<%= dom_id(message) %>"
     class="chat-message <%= message.role == "user" ? "chat-message--user" : "chat-message--assistant" %>">

  <% if message.role == "assistant" %>
    <%= mentor_avatar(workout_plan.mentor) %>
  <% end %>

  <div class="chat-bubble <%= message.role == "user" ? "chat-bubble--user" : "chat-bubble--assistant" %>">

    <%= simple_format(message.content) %>

    <% if message.workout_change_proposal.present? %>

      <%= render "chats/workout_proposal",
          proposal: message.workout_change_proposal %>

    <% end %>

  </div>

</div>
