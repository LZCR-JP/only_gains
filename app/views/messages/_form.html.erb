
<%= form_with model: [chat, message],
    class: "og-dm-form" do |form| %>

  <%= form.text_area :content,
      rows: 1,
      placeholder: "Message...",
      class: "og-dm-input",
      required: true,
      autocomplete: "off",
      aria: { label: "Message" },
      data: {
        action: "keydown.enter->chat-submit#keydown"
      } %>

  <button type="submit"
          class="og-dm-send"
          aria-label="Send message">

    <svg xmlns="http://www.w3.org/2000/svg"
         width="23"
         height="23"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round">

      <path d="M12 19V5"/>
      <path d="m5 12 7-7 7 7"/>

    </svg>

  </button>

<% end %>

<div class="og-dm-keyboard-hint">
  Enter to send · Shift + Enter for a new line
</div>
