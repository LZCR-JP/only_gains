
<div class="container py-5">

  <%= link_to "Back to Workout",
      workout_plan_path(@workout_plan),
      class: "btn btn-outline-secondary mb-4" %>

  <h1><%= @workout_plan.mentor.name %></h1>

  <p class="text-muted">Your AI Fitness Coach</p>

  <div class="card p-4 mb-4">

    <% @messages.each do |message| %>

      <div class="d-flex mb-3
        <%= message.role == "user" ?
            "justify-content-end" :
            "justify-content-start" %>">

        <div class="rounded p-3
          <%= message.role == "user" ?
              "bg-primary text-white" :
              "bg-light text-dark" %>"
          style="max-width: 80%;">

          <strong>
            <%= message.role == "user" ?
                "You" :
                @workout_plan.mentor.name %>
          </strong>

          <%= simple_format(message.content) %>
            <% if message.workout_change_proposal.present? %>

              <%= render "chats/workout_proposal",
                  proposal: message.workout_change_proposal %>

            <% end %>

        </div>

      </div>

    <% end %>

  </div>

  <%= form_with model: [@chat, @message] do |form| %>

    <%= form.text_area :content,
        rows: 3,
        placeholder: "Ask your AI coach anything...",
        class: "form-control mb-3",
        required: true %>

    <%= form.submit "Send",
        class: "btn btn-primary" %>

  <% end %>

</div>
