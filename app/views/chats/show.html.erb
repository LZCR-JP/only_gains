<div class="container py-5">

  <%= link_to "Back to Workout",
      workout_plan_path(@workout_plan),
      class: "btn btn-outline-secondary mb-4" %>

  <h1><%= @workout_plan.mentor.name %></h1>
  <p class="text-muted">Elite coaching</p>

  <div id="chat_alert"></div>

  <div class="card p-4 mb-4"
       data-controller="chat-scroll"
       style="max-height: 60vh; overflow-y: auto;">

    <div id="messages" data-chat-scroll-target="list">
      <% @messages.each do |message| %>
        <%= render "messages/message", message: message, workout_plan: @workout_plan %>
      <% end %>
    </div>

  </div>

  <div id="message_form">
    <%= render "messages/form", chat: @chat, message: @message %>
  </div>

</div>