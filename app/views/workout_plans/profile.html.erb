
<% content_for :title, "Your workout setup · Only Gains" %>

<div class="gf-page gf-setup-page">
  <div class="container">

    <%= link_to "← Change coach",
        new_workout_plan_path,
        class: "gf-back" %>

    <header class="gf-header">
      <span class="gf-eyebrow">
        Step 2 of 2 · Your profile
      </span>

      <h1 class="gf-title">Set up your workout</h1>

      <p class="gf-subtitle">
        Tell <%= @selected_mentor.display_name %> how you want to train.
      </p>
    </header>

    <div class="row g-3 align-items-start">

      <div class="col-lg-4">
        <section class="gf-card gf-mentor-card h-auto">
          <%= render "mentors/coach_profile",
              mentor: @selected_mentor %>
        </section>
      </div>

      <div class="col-lg-8">
        <div class="gf-form-card">
          <%= render "form",
              workout_plan: @workout_plan %>
        </div>
      </div>

    </div>

  </div>
</div>
