
<% content_for :title, "Your workout setup · Only Gains" %>

<div class="gf-page gf-setup-page">
  <div class="container">

    <%= link_to "← Change coach",
        new_workout_plan_path,
        class: "gf-back" %>

    <header class="gf-header">
      <span class="gf-eyebrow">
        Step 2 of 2 · BUILD YOUR PLAN
      </span>

      <h1 class="gf-title">Set up your workout</h1>

      <p class="gf-subtitle">
        Share your fitness goals with <%= @selected_mentor.display_name %>. Your coach will handle the rest.
      </p>
    </header>

    <div class="row g-3 align-items-stretch">

      <div class="col-lg-4">
        <section class="gf-mentor-stage"
                 data-controller="mentor-stage"
                 data-mentor-stage-name-value="<%= @selected_mentor.name %>"
                 data-mentor-stage-slug-value="<%= MentorVoice.slug_for(@selected_mentor.name) %>"
                 data-mentor-stage-quotes-value="<%= MentorVoice.quotes_for(@selected_mentor.name).to_json %>"
                 data-mentor-stage-voice-url-value="<%= mentor_voice_path %>">
          <div class="gf-mentor-stage-view">
            <div class="gf-mentor-stage-canvas"
                 data-mentor-stage-target="canvas"
                 role="img"
                 aria-label="Animated 3D figure of <%= @selected_mentor.display_name %>"></div>
            <div class="gf-mentor-stage-fallback" aria-hidden="true">
              <span><%= @selected_mentor.emoji %></span>
            </div>

            <header class="gf-mentor-stage-hud">
              <% if @selected_mentor.badge.present? %>
                <span class="gf-mentor-stage-tag"><%= @selected_mentor.badge %></span>
              <% end %>
              <h2 class="gf-mentor-stage-name"><%= @selected_mentor.display_name %></h2>
            </header>

            <button type="button"
                    class="gf-mentor-stage-voice"
                    data-mentor-stage-target="voiceButton"
                    data-action="mentor-stage#toggleVoice"
                    aria-pressed="true"
                    hidden>
              <i class="fa-solid fa-volume-high gf-voice-on" aria-hidden="true"></i>
              <i class="fa-solid fa-volume-xmark gf-voice-off" aria-hidden="true"></i>
              <span data-mentor-stage-target="voiceLabel">Sound ON</span>
            </button>

            <div class="gf-mentor-stage-subtitle" data-mentor-stage-target="subtitle">
              <span class="gf-mentor-stage-speaker"><%= @selected_mentor.display_name %></span>
              <p data-mentor-stage-target="subtitleText"></p>
            </div>
          </div>
        </section>
      </div>

      <div class="col-lg-8">
        <div class="gf-form-card">
          <%= render "form",
              workout_plan: @workout_plan %>
        </div>
      </div>

    </div>

  </div>
</div>
<footer class="gf-site-footer">
  <div class="container d-flex justify-content-between flex-wrap gap-2">
    <span>Built at Le Wagon Japan • Only Gains © 2026</span>
    <span>Keep showing up · The gains will follow</span>
  </div>
</footer>