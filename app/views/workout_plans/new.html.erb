
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

      <h1 class="mb-3">Create Your Workout Plan 💪</h1>

      <p class="text-muted mb-4">
        Tell us about your fitness goals and home workout setup.
      </p>

      <div class="card shadow-sm p-4">
        <%= render "form", workout_plan: @workout_plan %>
      </div>

      <%= link_to "Back to My Plans",
          workout_plans_path,
          class: "btn btn-outline-secondary mt-3" %>

    </div>
  </div>
</div>
