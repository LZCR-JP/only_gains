
<% content_for :title, "Choose your coach · Only Gains" %>

<div class="gf-page gf-coach-selection">
  <div class="container">

    <%= link_to "← Back to home", root_path, class: "gf-back" %>

    <!-- HEADER -->
    <header class="gf-header" data-controller="reveal">

      <div class="gf-selection-progress">
        <span class="is-active"></span>
        <span></span>
      </div>

      <span class="gf-eyebrow">
        <span class="gf-dot"></span>
        Step 1 of 2 · Your coach
      </span>

      <h1 class="gf-title">
        Choose your <span class="gf-gradient-text">coach.</span>
      </h1>

    </header>

    <% if @workout_plan.errors.any? %>
      <div class="alert alert-danger" role="alert">
        <%= @workout_plan.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <% if @mentors.empty? %>

      <div class="gf-card">
        <p class="gf-muted mb-0">
          No coaches available yet.
        </p>
      </div>

    <% else %>

      <% specialties = {
        "Arnold “The Oak”" => "Best for building muscle, strength, and a powerful physique",
        "David Goggins" => "Best for mental toughness, endurance, and breaking limits",
        "Jonah Hill" => "Best for weight loss, healthy habits, and building confidence",
        "Master Yoda" => "Best for flexibility, recovery, and moving without pain",
        "Sonic" => "Best for cardio lovers who want to move faster and train harder",
        "Mikasa Ackerman" => "Best for athletic strength, balance, and total-body control"
      } %>

      <!-- COACH GRID -->
      <div class="gf-selection-grid"
           data-controller="reveal"
           data-reveal-stagger-value="70">

        <% @mentors.each do |mentor| %>

          <article class="gf-card gf-selection-card"
                   data-reveal-target="item">

            <!-- COACH PHOTO -->
            <div class="gf-selection-photo">
              <%= mentor_avatar(mentor, variant: :selection) %>
            </div>

            <!-- COACH INFORMATION -->
            <div class="gf-selection-content">

              <h2 class="gf-selection-name">
                <%= mentor.display_name %>
              </h2>

              <p class="gf-selection-specialty">
                <%= specialties.fetch(mentor.name, "General Fitness") %>
              </p>

              <%= link_to new_workout_plan_path(mentor_id: mentor.id),
                  class: "gf-btn gf-btn-primary gf-btn-block mt-auto",
                  aria: { label: "Select #{mentor.display_name}" } do %>
                Select &nbsp; →
              <% end %>

            </div>

          </article>

        <% end %>

      </div>

    <% end %>

  </div>
</div>

<!-- FOOTER -->
<footer class="gf-site-footer">
  <div class="container d-flex justify-content-between flex-wrap gap-2">
    <span>Built at Le Wagon Japan • Only Gains © 2026</span>
    <span>Keep showing up · The gains will follow</span>
  </div>
</footer>
