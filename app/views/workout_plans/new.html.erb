<% content_for :title, "New plan · Only Gains" %>

<div class="gf-page">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-9 col-lg-7" data-controller="reveal">
        <%= link_to "← Back to my plans", workout_plans_path, class: "gf-back" %>

        <header class="gf-header">
          <span class="gf-eyebrow"><span class="gf-dot"></span>New plan</span>
          <h1 class="gf-title">Create your plan 💪</h1>
          <p class="gf-subtitle">Tell us about your goals and home setup. Your mentor handles the yelling.</p>
        </header>

        <div class="gf-form-card">
          <%= render "form", workout_plan: @workout_plan %>
        </div>
      </div>
    </div>
  </div>
</div>
