<% content_for :title, "Choose your coach · Only Gains" %>

<div class="gf-page">
  <div class="container">
    <%= link_to "← Back to my plans", workout_plans_path, class: "gf-back" %>

    <header class="gf-header" data-controller="reveal">
      <span class="gf-eyebrow"><span class="gf-dot"></span>Step 1 of 2 · Your coach</span>
      <h1 class="gf-title">Choose your coach</h1>
      <p class="gf-subtitle">Explore each coach's style, specialty, and signature quote. Find the legend you want in your corner.</p>
    </header>

    <% if @workout_plan.errors.any? %>
      <div class="alert alert-danger" role="alert"><%= @workout_plan.errors.full_messages.to_sentence %></div>
    <% end %>

    <% if @mentors.empty? %>
      <div class="gf-card"><p class="gf-muted mb-0">No coaches available yet. Run <code>bin/rails db:seed</code> and try again.</p></div>
    <% else %>
      <div class="row g-3" data-controller="reveal">
        <% @mentors.each do |mentor| %>
          <div class="col-md-6 col-lg-4" data-reveal-target="item">
            <article class="gf-card gf-mentor-card h-100 d-flex flex-column" data-controller="tilt" data-tilt-max-value="5">
              <%= render "mentors/coach_profile", mentor: mentor %>
              <%= link_to "Choose #{mentor.display_name} →",
                    new_workout_plan_path(mentor_id: mentor.id),
                    class: "gf-btn gf-btn-primary gf-btn-block mt-auto" %>
            </article>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
<footer class="gf-site-footer">
  <div class="container d-flex justify-content-between flex-wrap gap-2">
    <span>Built at Le Wagon Japan • Only Gains © 2026</span>
    <span>Keep showing up · The gains will follow</span>
  </div>
</footer>