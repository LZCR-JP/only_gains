<% content_for :title, "#{@workout_plan.title} · Only Gains" %>

<% mentor = @workout_plan.mentor %>
<% days = @days || @workout_plan.generated_workout&.fetch("days", []) || [] %>
<% chats = @chats || @workout_plan.chats.order(created_at: :desc, id: :desc).to_a %>
<% completed_day_names = @completed_day_names || [] %>
<% today = Date.current.strftime("%A") %>
<% training_schedule = Array(@workout_plan.training_schedule) %>

<div class="gf-page gf-workout-page">
  <div class="container">
    <%= link_to "← My plans", workout_plans_path, class: "gf-back" %>

    <%# Today's plan is the main focus %>
    <% if @schedule_configured && @today_workout.present? %>
      <section class="gf-todays-plan">
        <div>
          <p class="gf-eyebrow">TODAY'S PLAN · <%= today.upcase %></p>
          <h1><%= @today_workout["name"] %></h1>
          <p><%= pluralize(@today_workout.fetch("exercises", []).size, "exercise") %></p>
        </div>

        <div class="gf-todays-plan-actions">
          <%= link_to "Start today’s workout",
              "#workout-day-#{@today_day_index + 1}",
              class: "gf-btn gf-btn-primary" %>

          <%= link_to "Edit plan",
              edit_workout_plan_path(@workout_plan),
              class: "gf-btn gf-btn-outline" %>
        </div>
      </section>
    <% elsif @schedule_configured %>
      <section class="gf-todays-plan">
        <p class="gf-eyebrow">TODAY · <%= today.upcase %></p>
        <h1>Rest day</h1>
        <p>Your next scheduled workout is coming up below.</p>
      </section>
    <% else %>
      <section class="gf-todays-plan">
        <div>
          <p class="gf-eyebrow">YOUR TRAINING SCHEDULE</p>
          <h1>Choose your training days</h1>
          <p>Set your weekly schedule to see today’s plan here.</p>
        </div>

        <%= link_to "Edit plan",
            edit_workout_plan_path(@workout_plan),
            class: "gf-btn gf-btn-primary" %>
      </section>
    <% end %>

    <%# Next scheduled workout %>
    <% if @schedule_configured && @next_session_workout.present? %>
      <section class="gf-next-session">
        <div>
          <p class="gf-eyebrow">
            NEXT SESSION · <%= @next_session_date.strftime("%A, %B %-d").upcase %>
          </p>
          <h2><%= @next_session_workout["name"] %></h2>
          <p><%= pluralize(@next_session_workout.fetch("exercises", []).size, "exercise") %></p>
        </div>

        <%= link_to "View workout",
            "#workout-day-#{@next_session_day_index + 1}",
            class: "gf-btn gf-btn-outline" %>
      </section>
    <% end %>

    <%# Compact plan summary and progress %>
      <div class="gf-workout-progress">
        <div class="d-flex justify-content-between">
          <strong>Current week</strong>
          <span>
            <%= @completed_sessions || 0 %> of
            <%= @weekly_target || @workout_plan.training_days %>
            sessions logged
          </span>
        </div>

        <div class="progress"
             role="progressbar"
             aria-label="Weekly workout progress"
             aria-valuenow="<%= @progress_percentage || 0 %>"
             aria-valuemin="0"
             aria-valuemax="100">
          <div class="progress-bar"
               style="width: <%= @progress_percentage || 0 %>%"></div>
        </div>
      </div>
    </section>

    <%# Full weekly plan %>
    <div class="gf-workout-section-heading">
      <h2>Your weekly workout</h2>
    </div>

    <% if days.any? %>
      <div class="gf-workout-grid">
        <% days.each_with_index do |day, index| %>
          <% exercises = day.fetch("exercises", []) %>
          <% day_name = day["name"].to_s %>
          <% day_title = day_name.sub(/\ADay\s*\d+\s*[-:–—]?\s*/i, "").presence || "Workout" %>
          <% weekday = training_schedule[index] %>
          <% weekday_label = weekday.presence || "Day #{index + 1}" %>
          <% completed = completed_day_names.include?(day_name) %>

          <article class="gf-workout-day" id="workout-day-<%= index + 1 %>">
            <header class="gf-workout-day-header">
              <div class="gf-workout-day-weekday"
                  aria-label="<%= weekday_label %>">
                <%= weekday ? weekday.first(3).upcase : "DAY #{index + 1}" %>
              </div>

              <div>
                <h3><%= day_title %></h3>
                <small><%= pluralize(exercises.size, "exercise") %></small>
              </div>

              <div class="gf-workout-day-tools">
                <% if chats.any? %>
                  <%= link_to "💬",
                      workout_plan_chat_path(@workout_plan, chats.first),
                      class: "gf-icon-btn",
                      title: "Chat with your coach about #{day_title}",
                      aria: { label: "Chat with your coach about #{day_title}" } %>
                <% else %>
                  <%= button_to "💬",
                      workout_plan_chats_path(@workout_plan),
                      method: :post,
                      class: "gf-icon-btn",
                      title: "Chat with your coach about #{day_title}",
                      aria: { label: "Chat with your coach about #{day_title}" } %>
                <% end %>

                <%= link_to "✎",
                    edit_workout_plan_path(@workout_plan),
                    class: "gf-icon-btn",
                    title: "Edit workout plan",
                    aria: { label: "Edit workout plan" } %>
              </div>
            </header>

            <table class="gf-workout-table">
              <thead>
                <tr>
                  <th scope="col">Exercise</th>
                  <th scope="col">Sets</th>
                  <th scope="col">Reps</th>
                  <th scope="col">Rest</th>
                </tr>
              </thead>

              <tbody>
                <% exercises.each do |exercise| %>
                  <tr>
                    <td class="gf-exercise-name"><%= exercise["name"] %></td>
                    <td class="gf-exercise-sets"><%= exercise["sets"] %></td>
                    <td><%= exercise["reps"] %></td>
                    <td class="gf-exercise-rest"><%= exercise["rest_seconds"] %>s</td>
                  </tr>
                <% end %>
              </tbody>
            </table>

            <div class="gf-workout-day-actions">
              <% if completed %>
                <span class="gf-workout-day-status">Logged this week</span>
              <% else %>
                <%= button_to "Mark complete",
                    workout_plan_workout_logs_path(@workout_plan),
                    method: :post,
                    params: { workout_log: { day_name: day_name } },
                    class: "gf-btn gf-btn-outline" %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="gf-workout-empty">
        <h3>Your workout is not ready yet.</h3>
        <p>Edit your plan to generate a personalized workout.</p>
        <%= link_to "Generate workout",
            edit_workout_plan_path(@workout_plan),
            class: "gf-btn gf-btn-primary" %>
      </div>
    <% end %>

    <div class="gf-workout-footer">
      <%= button_to "Delete workout",
          workout_plan_path(@workout_plan),
          method: :delete,
          form: { data: { turbo_confirm: "Delete this workout and its conversations?" } },
          class: "gf-workout-delete" %>
    </div>
  </div>
</div>
