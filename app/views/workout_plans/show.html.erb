
<% content_for :title, "#{@workout_plan.title} · Only Gains" %>

<% mentor = @workout_plan.mentor %>
<% days = @workout_plan.generated_workout&.fetch("days", []) || [] %>
<% chats = @workout_plan.chats.order(created_at: :desc, id: :desc).to_a %>

<div class="gf-page gf-workout-page">
  <div class="container">

    <%= link_to "← My plans",
        workout_plans_path,
        class: "gf-back" %>

    <!-- Plan title -->

    <div class="gf-workout-heading">

      <h1><%= @workout_plan.title %></h1>

      <%= link_to "Edit plan",
          edit_workout_plan_path(@workout_plan),
          class: "gf-btn gf-btn-outline" %>

    </div>

    <!-- Coach -->

    <section class="gf-workout-summary">

      <div class="gf-workout-coach">

        <div class="gf-workout-coach-info">

          <%= mentor_avatar(mentor) %>

          <div>
            <h3><%= mentor.display_name %></h3>
            <p><%= mentor.specialty %></p>
          </div>

        </div>

        <% if chats.any? %>

          <%= link_to "Chat with coach ↗",
              workout_plan_chat_path(@workout_plan, chats.first),
              class: "gf-btn gf-btn-primary" %>

        <% else %>

          <%= button_to "Chat with coach ↗",
              workout_plan_chats_path(@workout_plan),
              method: :post,
              class: "gf-btn gf-btn-primary" %>

        <% end %>

      </div>

      <!-- Compact workout information -->

      <div class="gf-workout-meta">

        <span>
          <%= @workout_plan.fitness_level&.humanize || "All levels" %>
        </span>

        <span>
          <%= @workout_plan.training_days %> days / week
        </span>

        <span>
          <%= @workout_plan.duration_minutes %> min / session
        </span>

        <span>
          <%= @workout_plan.equipment.presence || "Bodyweight" %>
        </span>

      </div>

      <% if @workout_plan.description.present? %>
        <details class="gf-workout-notes">
          <summary>Training notes</summary>
          <p><%= @workout_plan.description %></p>
        </details>
      <% end %>

    </section>

    <!-- AI generated workout -->

    <div class="gf-workout-section-heading">

      <h2>Your workout</h2>

      <span>✦ AI generated</span>

    </div>

    <% if days.any? %>

      <div class="gf-workout-grid">

        <% days.each_with_index do |day, index| %>

          <% exercises = day.fetch("exercises", []) %>

          <% day_title = day["name"].to_s.sub(/\ADay\s*\d+\s*[-:–—]?\s*/i, "").presence || "Workout" %>

          <article class="gf-workout-day">

            <header class="gf-workout-day-header">

              <div class="gf-workout-day-number">
                <%= format("%02d", index + 1) %>
              </div>

              <div>
                <h3><%= day_title %></h3>

                <small>
                  <%= pluralize(exercises.size, "exercise") %>
                </small>
              </div>

            </header>

            <table class="gf-workout-table">

              <thead>
                <tr>
                  <th scope="col">Exercise</th>
                  <th scope="col">Sets</th>
                  <th scope="col">Reps</th>
                  <th scope="col">Rest</th>
                </tr>
              </thead>

              <tbody>

                <% exercises.each do |exercise| %>

                  <tr>

                    <td class="gf-exercise-name">
                      <%= exercise["name"] %>
                    </td>

                    <td class="gf-exercise-sets">
                      <%= exercise["sets"] %>
                    </td>

                    <td>
                      <%= exercise["reps"] %>
                    </td>

                    <td class="gf-exercise-rest">
                      <%= exercise["rest_seconds"] %>s
                    </td>

                  </tr>

                <% end %>

              </tbody>

            </table>

          </article>

        <% end %>

      </div>

    <% else %>

      <div class="gf-workout-empty">

        <h3>Your workout is not ready yet.</h3>

        <p>Edit your plan to generate a personalized workout.</p>

        <%= link_to "Generate workout",
            edit_workout_plan_path(@workout_plan),
            class: "gf-btn gf-btn-primary" %>

      </div>

    <% end %>


    <div class="gf-workout-footer">

      <%= button_to "Delete workout",
          workout_plan_path(@workout_plan),
          method: :delete,
          form: {
            data: {
              turbo_confirm: "Delete this workout and its conversations?"
            }
          },
          class: "gf-workout-delete" %>

    </div>

  </div>
</div>
