<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= @workout_plan.title %> 💪</h1>

    <%= link_to "Back to Plans",
                workout_plans_path,
                class: "btn btn-outline-secondary" %>
  </div>

  <div class="card shadow-sm p-4">
    <h3 class="mb-4">Workout Details</h3>

    <p>
      <strong>Goal:</strong>
      <%= @workout_plan.goal&.humanize %>
    </p>

    <p>
      <strong>AI Coach:</strong>
      <%= @workout_plan.mentor&.name || "Not selected" %>
    </p>

    <p>
      <strong>Fitness Level:</strong>
      <%= @workout_plan.fitness_level&.humanize %>
    </p>

    <p>
      <strong>Equipment:</strong>
      <%= @workout_plan.equipment %>
    </p>

    <p>
      <strong>Training Days:</strong>
      <%= @workout_plan.training_days %> days/week
    </p>

    <p>
      <strong>Duration:</strong>
      <%= @workout_plan.duration_minutes %> minutes
    </p>

    <p>
      <strong>Description:</strong>
      <%= @workout_plan.description.presence || "No description" %>
    </p>

    <hr>

    <div class="d-flex gap-2">
      <%= link_to "Edit Plan",
                  edit_workout_plan_path(@workout_plan),
                  class: "btn btn-primary" %>

      <%= button_to "Delete Plan",
                    workout_plan_path(@workout_plan),
                    method: :delete,
                    class: "btn btn-danger",
                    form: {
                      data: {
                        turbo_confirm: "Are you sure you want to delete this plan?"
                      }
                    } %>
    </div>
  </div>

  <div class="card shadow-sm p-4 mt-4">
    <h3 class="mb-3">AI Coach Chats</h3>

    <% if @workout_plan.chats.any? %>
      <% @workout_plan.chats.each do |chat| %>
        <p>
          <%= link_to chat.title,
                      workout_plan_chat_path(@workout_plan, chat) %>
        </p>
      <% end %>
    <% else %>
      <p>No chats yet. Start a conversation with your AI coach.</p>
    <% end %>

    <%= button_to "Start a chat",
                  workout_plan_chats_path(@workout_plan),
                  method: :post,
                  class: "btn btn-success" %>
  </div>
</div>