<% content_for :title, "#{@workout_plan.title} · Only Gains" %>

<% mentor = @workout_plan.mentor %>
<% days = @days %>
<% chats = @chats %>
<% next_day_anchor = "workout-day-#{@next_day_index + 1}" %>

<div class="gf-page gf-workout-page">
  <div class="container">
    <%= link_to "← My plans",
        workout_plans_path,
        class: "gf-back" %>

    <section class="gf-workout-hero">
      <div class="gf-workout-hero-heading">
        <div>
          <p class="gf-workout-eyebrow">YOUR TRAINING PLAN</p>
          <h1><%= @workout_plan.title %></h1>
          <p class="gf-workout-goal">
            Built for <%= @workout_plan.goal&.humanize || "your fitness goals" %>
          </p>
        </div>

        <div class="gf-workout-hero-coach">
          <%= mentor_avatar(mentor) %>
          <div>
            <strong><%= mentor.display_name %></strong>
            <span><%= mentor.specialty %></span>
          </div>
        </div>
      </div>

      <div class="gf-workout-stats">
        <div>
          <span>DIFFICULTY</span>
          <strong><%= @workout_plan.fitness_level&.humanize || "All levels" %></strong>
        </div>

        <div>
          <span>SESSION</span>
          <strong><%= @workout_plan.duration_minutes %> min</strong>
        </div>

        <div>
          <span>WEEKLY TARGET</span>
          <strong><%= pluralize(@weekly_target, "session") %></strong>
        </div>

        <div>
          <span>EQUIPMENT</span>
          <strong><%= @workout_plan.equipment.presence || "Bodyweight" %></strong>
        </div>
      </div>

      <div class="gf-workout-progress">
        <div class="gf-workout-progress-label">
          <strong>This week</strong>
          <span><%= @completed_sessions %> of <%= @weekly_target %> sessions logged</span>
        </div>

        <div
          class="gf-workout-progress-track"
          role="progressbar"
          aria-label="Weekly workout progress"
          aria-valuemin="0"
          aria-valuemax="<%= @weekly_target %>"
          aria-valuenow="<%= [@completed_sessions, @weekly_target].min %>">
          <div
            class="gf-workout-progress-fill"
            style="width: <%= @progress_percentage %>%">
          </div>
        </div>
      </div>

      <div class="gf-workout-coach-note">
        <strong><%= mentor.display_name %>’s note</strong>
        <p class="mb-0">
          Your focus is <%= @workout_plan.goal&.humanize || "steady progress" %>.
          Train at a pace you can sustain, and ask me if an exercise needs adjusting.
        </p>
      </div>

      <div class="gf-workout-hero-actions">
        <% if days.any? %>
          <%= link_to "Start workout →",
              "##{next_day_anchor}",
              class: "gf-btn gf-btn-primary" %>
        <% end %>

        <% if chats.any? %>
          <%= link_to "Chat with #{mentor.display_name}",
              workout_plan_chat_path(@workout_plan, chats.first),
              class: "gf-btn gf-btn-outline" %>
        <% else %>
          <%= button_to "Chat with #{mentor.display_name}",
              workout_plan_chats_path(@workout_plan),
              method: :post,
              class: "gf-btn gf-btn-outline" %>
        <% end %>

        <%= link_to "Edit plan",
            edit_workout_plan_path(@workout_plan),
            class: "gf-btn gf-btn-outline" %>
      </div>

      <% if @workout_plan.description.present? %>
        <details class="gf-workout-notes">
          <summary>Training notes</summary>
          <p><%= @workout_plan.description %></p>
        </details>
      <% end %>
    </section>

    <div class="gf-workout-section-heading">
      <h2>Your workout</h2>
    </div>

    <% if days.any? %>
      <div class="gf-workout-grid">
        <% days.each_with_index do |day, index| %>
          <% exercises = day.fetch("exercises", []) %>
          <% completed = @completed_day_names.include?(day["name"]) %>
          <% day_title = day["name"].to_s.sub(/\ADay\s*\d+\s*[-:–—]?\s*/i, "").presence || "Workout" %>

          <article
            id="workout-day-<%= index + 1 %>"
            class="gf-workout-day<%= ' is-complete' if completed %>">

            <header class="gf-workout-day-header">
              <div class="gf-workout-day-number">
                <%= format("%02d", index + 1) %>
              </div>

              <div>
                <h3><%= day_title %></h3>
                <small><%= pluralize(exercises.size, "exercise") %></small>
              </div>

              <% if completed %>
                <span class="gf-workout-day-status">Logged this week</span>
              <% end %>
            </header>

            <table class="gf-workout-table">
              <thead>
                <tr>
                  <th scope="col">Exercise</th>
                  <th scope="col">Sets</th>
                  <th scope="col">Reps</th>
                  <th scope="col">Rest</th>
                </tr>
              </thead>

              <tbody>
                <% exercises.each do |exercise| %>
                  <tr>
                    <td class="gf-exercise-name"><%= exercise["name"] %></td>
                    <td class="gf-exercise-sets"><%= exercise["sets"] %></td>
                    <td><%= exercise["reps"] %></td>
                    <td class="gf-exercise-rest"><%= exercise["rest_seconds"] %>s</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="gf-workout-empty">
        <h3>Your workout is not ready yet.</h3>
        <p>Edit your plan to generate a personalized workout.</p>

        <%= link_to "Generate workout",
            edit_workout_plan_path(@workout_plan),
            class: "gf-btn gf-btn-primary" %>
      </div>
    <% end %>

    <div class="gf-workout-footer">
      <%= button_to "Delete workout",
          workout_plan_path(@workout_plan),
          method: :delete,
          form: {
            data: {
              turbo_confirm: "Delete this workout and its conversations?"
            }
          },
          class: "gf-workout-delete" %>
    </div>
  </div>
</div>