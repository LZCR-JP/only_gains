
<div class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Workout Plans 💪</h1>

    <%= link_to "Create New Plan",
        new_workout_plan_path,
        class: "btn btn-primary" %>
  </div>

  <% if @workout_plans.any? %>

    <div class="row">
      <% @workout_plans.each do |plan| %>

        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card p-4 h-100 shadow-sm">

            <h3><%= plan.title %></h3>

            <p>
              <strong>Goal:</strong>
              <%= plan.goal.humanize %>
            </p>

            <p>
              <strong>Fitness Level:</strong>
              <%= plan.fitness_level&.humanize %>
            </p>

            <p>
              <strong>Duration:</strong>
              <%= plan.duration_minutes %> minutes
            </p>

            <%= link_to "View Plan",
                workout_plan_path(plan),
                class: "btn btn-primary mt-auto" %>

          </div>
        </div>

      <% end %>
    </div>

  <% else %>

    <div class="text-center py-5">
      <h3>No workout plans yet!</h3>
      <p class="text-muted">
        Create your first personalized home workout plan.
      </p>

      <%= link_to "Create My First Plan",
          new_workout_plan_path,
          class: "btn btn-primary mt-3" %>
    </div>

  <% end %>

</div>
