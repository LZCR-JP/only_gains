
<%= simple_form_for workout_plan do |f| %>
<%= f.error_notification %>
<%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <%= f.input :title,
      placeholder: "My Home Workout Plan" %>

  <%= f.input :goal,
      collection: [
        ["Bulking", "bulking"],
        ["Endurance", "endurance"],
        ["Weight Loss", "losing_weight"]
      ],
      prompt: "Choose your fitness goal",
      hint: "Your AI coach will be automatically assigned based on your goal.",
      required: true %>

  <%= f.input :fitness_level,
      collection: [
        ["Beginner", "beginner"],
        ["Intermediate", "intermediate"],
        ["Advanced", "advanced"]
      ],
      prompt: "Select your fitness level" %>

  <%= f.input :equipment,
      placeholder: "Dumbbells, yoga mat, or none" %>

  <%= f.input :training_days,
      collection: 1..7 %>

  <%= f.input :duration_minutes,
      collection: [15, 20, 30, 45, 60, 90] %>

  <%= f.input :description,
      as: :text,
      placeholder: "Additional information (optional)" %>

  <%= f.button :submit,
      class: "btn btn-primary mt-3" %>

<% end %>
