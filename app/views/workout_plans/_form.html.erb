<%= simple_form_for workout_plan do |f| %>
<%= f.error_notification %>
<%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <%= f.input :title, placeholder: "My Home Workout Plan" %>

  <%= f.input :goal,
      collection: [
        ["Bulking", "bulking"],
        ["Endurance", "endurance"],
        ["Weight Loss", "losing_weight"]
      ],
      prompt: "Choose your fitness goal",
      hint: "Your AI coach will be automatically assigned based on your goal.",
      required: true %>

  <%= f.input :equipment, placeholder: "Dumbbells, yoga mat, or none" %>

  <div class="row">
    <div class="col-sm-6">
      <%= f.input :training_days, label: "Training days / week", collection: 1..7, include_blank: false %>
    </div>
    <div class="col-sm-6">
      <%= f.input :duration_minutes, label: "Session length (min)", collection: [15, 20, 30, 45, 60, 90], include_blank: false %>
    </div>
  </div>

  <%= f.input :description,
      as: :text,
      input_html: { rows: 4 },
      placeholder: "Injuries, preferences, anything your mentor should know (optional)" %>

  <%= f.button :button, class: "gf-btn gf-btn-primary gf-btn-block mt-2" do %>
    ⚡ <%= workout_plan.persisted? ? "Save changes" : "Create plan" %>
  <% end %>
<% end %>
