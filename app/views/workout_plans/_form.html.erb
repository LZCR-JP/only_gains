<% editing = workout_plan.persisted? %>

<%= simple_form_for workout_plan,
    url: editing ? workout_plan_path(workout_plan) : workout_plans_path,
    html: {
      data: {
        controller: "workout-form",
        action: "turbo:submit-start->workout-form#start turbo:submit-end->workout-form#finish"
      }
    } do |f| %>

  <%= f.error_notification %>

  <% unless editing %>
    <%= f.hidden_field :mentor_id %>
  <% end %>

  <div class="row g-2">
    <div class="col-md-6">
      <%= f.input :title,
          label: "Plan name",
          placeholder: "e.g. #{workout_plan.goal&.humanize || 'Custom workout'} plan",
          required: true %>
    </div>

    <div class="col-md-6">
      <%= f.input :fitness_level,
          collection: WorkoutPlan.fitness_levels.keys.map { |level| [level.humanize, level] },
          include_blank: "Select level",
          required: true %>
    </div>
  </div>

  <div class="mb-3 position-relative" data-controller="equipment-picker">
    <label class="form-label">Equipment (optional)</label>

    <button type="button"
            class="form-select text-start d-flex flex-wrap gap-1 align-items-center"
            data-action="equipment-picker#toggle">
      <span class="d-flex flex-wrap gap-1" data-equipment-picker-target="summary">
        Select your equipment...
      </span>
    </button>

    <div class="card p-2 mt-1 position-absolute w-100 shadow"
         style="z-index: 10;"
         data-equipment-picker-target="panel"
         hidden>
      <%= hidden_field_tag "workout_plan[equipment_list][]", "", id: nil %>

      <div class="row g-1">
        <% WorkoutPlan::EQUIPMENT_OPTIONS.each do |option| %>
          <% box_id = "equipment_#{option.parameterize(separator: '_')}" %>

          <div class="col-6">
            <div class="form-check">
              <%= check_box_tag "workout_plan[equipment_list][]",
                  option,
                  workout_plan.equipment_list.include?(option),
                  id: box_id,
                  class: "form-check-input",
                  data: { action: "change->equipment-picker#update" } %>

              <%= label_tag box_id, option, class: "form-check-label" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <small class="form-text text-muted">
      Leave blank for bodyweight-only training.
    </small>
  </div>

  <div class="row g-2">
    <div class="col-sm-6">
      <%= f.input :training_days,
          label: "How many days can you train?",
          collection: (1..7).map { |days| ["#{days} #{'day'.pluralize(days)}", days] },
          include_blank: "Choose your weekly rhythm",
          required: true,
          hint: "Choose a schedule that fits your routine." %>
    </div>

    <div class="col-sm-6">
      <%= f.input :duration_minutes,
          label: "How long can you train?",
          collection: [20, 30, 45, 60, 90, 120].map { |minutes| ["#{minutes} minutes", minutes] },
          include_blank: "Choose a session length",
          required: true,
          hint: "Choose a session length that fits your routine." %>
    </div>
  </div>

  <%= f.input :description,
      label: "Anything else? (Optional)",
      as: :text,
      input_html: { rows: 2, maxlength: 500 },
      placeholder: "Preferences, limitations, or extra equipment..." %>

  <% if editing %>
    <%= f.input :mentor_id,
        label: "AI coach",
        collection: @mentors.map { |mentor| ["#{mentor.display_name} — #{mentor.specialty}", mentor.id] },
        include_blank: "Select your coach",
        required: true,
        hint: "Changing your coach or training preferences will regenerate your workout." %>
  <% end %>


  <p class="gf-form-helper text-center mb-3">
  The hardest part is starting. You're almost there.
</p>

<%= f.button :button,
    type: "submit",
    class: "gf-btn gf-btn-primary gf-btn-block mt-2" do %>
  <%= editing ? "Save changes" : "Build my workout →" %>
<% end %>

<div class="d-none text-center mt-3"
     data-workout-form-target="indicator"
     role="status">
  <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
  <span class="ms-2">
    <%= editing ? "Saving your changes…" : "Building your plan…" %>
  </span>
</div>
<% end %>