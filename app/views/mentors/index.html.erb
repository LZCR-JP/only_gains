<% content_for :title, "Coaches · Only Gains" %>

<div class="gf-page">
  <div class="container">
    <header class="gf-header" data-controller="reveal">
      <span class="gf-eyebrow"><span class="gf-dot"></span><%= @mentors.size %> coaches available</span>
      <h1 class="gf-title">Choose your coach</h1>
      <p class="gf-subtitle">Each coach has a specialty and a signature line. Pick your training partner.</p>
    </header>

    <div class="row g-3" data-controller="reveal">
      <% @mentors.each do |mentor| %>
        <div class="col-md-6 col-lg-4" data-reveal-target="item">
          <article class="gf-card gf-mentor-card h-100 d-flex flex-column" data-controller="tilt" data-tilt-max-value="5">
            <%= render "coach_profile", mentor: mentor %>
            <%= link_to "Choose #{mentor.display_name} →",
                  new_workout_plan_path(mentor_id: mentor.id),
                  class: "gf-btn gf-btn-primary gf-btn-block mt-auto mb-3" %>
            <%= render "assign_form", mentor: mentor, plans: @plans %>
          </article>
        </div>
      <% end %>
    </div>
  </div>
</div>
