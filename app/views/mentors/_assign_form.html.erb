<%# locals: mentor, plans %>
<% if plans.any? %>
  <%= form_with url: assign_mentor_path(mentor), method: :patch, class: "gf-assign" do |f| %>
    <% options = plans.map { |p| [p.mentor_id == mentor.id ? "#{p.title} ✓" : p.title, p.id, { disabled: p.mentor_id == mentor.id }] } %>
    <%= f.select :workout_plan_id, options,
          { prompt: "Change coach for plan…" },
          class: "form-select", required: true,
          aria: { label: "Choose a plan for #{mentor.name}" } %>
    <%= f.button "Review", type: "submit", class: "gf-btn gf-btn-ghost gf-btn-sm" %>
  <% end %>
<% end %>
