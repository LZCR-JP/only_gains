<% content_for :title, "#{@mentor.display_name} · Only Gains" %>

<div class="gf-page">
  <div class="container" data-controller="reveal">
    <%= link_to "← Choose your coach", new_workout_plan_path, class: "gf-back" %>

    <header class="gf-header gf-mentor-hero" data-reveal-target="item">
      <%= mentor_avatar(@mentor, size: :xl) %>
      <div>
        <h1 class="gf-title mb-0"><%= @mentor.display_name %></h1>
      </div>
    </header>

    <div class="row g-3">
      <div class="col-lg-7" data-reveal-target="item">
        <section class="gf-card">
          <h2 class="gf-pink h5"><%= @mentor.specialty %></h2>
          <blockquote class="gf-quote fs-5">“<%= @mentor.tagline %>”</blockquote>
          <%= link_to "Choose #{@mentor.display_name} →",
                new_workout_plan_path(mentor_id: @mentor.id),
                class: "gf-btn gf-btn-primary gf-btn-block" %>
        </section>
      </div>

      <div class="col-lg-5" data-reveal-target="item">
        <aside class="gf-card">
          <span class="gf-label"><span class="gf-dot"></span>Change coach for an existing plan</span>
          <%= render "assign_form", mentor: @mentor, plans: @plans %>
        </aside>
      </div>
    </div>
  </div>
</div>
